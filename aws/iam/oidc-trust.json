          "token.actions.githubusercontent.com:sub": [
            "repo:buithinh2000/Wish-Garden:environment:wish-garden-aws-staging",
            "repo:buithinh2000@59677589/Wish-Garden@1444894477:environment:wish-garden-aws-staging"
          ]
        }
      }
    }
  ]
